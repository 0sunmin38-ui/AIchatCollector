  "concepts": {
    "statusboard": {
      "label": "상태창 계열",
      "desc": "캐릭터챗 매턴의 변화를 기록해 보여주는 UI. 개념은 '상태창'이고 이를 html 등으로 구현한 게 위젯·트래커. 플랫폼마다 부르는 이름이 다르다."
    },
    "pc": {
      "label": "유저 캐릭터",
      "desc": "NPC와 롤플레이를 진행하기 위한 사용자 쪽 캐릭터. {{user}} 로 지칭된다."
    },
    "npc": {
      "label": "제작된 캐릭터",
