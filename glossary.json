    },
    "asset": {
      "label": "캐릭터 이미지",
      "desc": "캐릭터에 붙는 이미지 리소스"
    },
    "ooc": {
      "label": "OOC",
      "desc": "진행 상황과 무관한 상황을 상정해 캐릭터 반응을 유도하는 번외 롤플레이"
    },
    "guideline": {
      "label": "지침",
      "desc": "출력을 조정하기 위해 제작 프롬프트나 유저노트에 넣는 지시문"
    },
    "artstyle": {
      "label": "그림체 고정",
      "desc": "작가태그·프롬프트를 깎아 그림체를 고정하는 작업과 그 결과물"
